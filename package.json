{
   "name": "my-ai-app",
   "module": "index.ts",
   "type": "module",
   "private": true,
   "scripts": {
      "dev": "bun run index.ts",
      "setup": "bun install && cd packages/server && bun run db:setup",
      "db:seed": "cd packages/server && bun run db:seed",
      "format": "prettier --write .",
      "prepare": "husky"
   },
   "devDependencies": {
      "@types/bun": "latest",
      "concurrently": "^9.2.1",
      "husky": "^9.1.7",
      "lint-staged": "^16.3.2",
      "prettier": "^3.8.1"
   },
   "peerDependencies": {
      "typescript": "^5"
   },
   "workspaces": [
      "packages/*"
   ],
   "dependencies": {
      "@tailwindcss/vite": "^4.2.1",
      "ollama": "^0.6.3",
      "tailwindcss": "^4.2.1"
   }
}
