# Copy this file to .env and fill in your own values.
# Never commit .env; it is ignored by git.

# OpenAI: used by the chatbot (/chat)
OPENAI_API_KEY=your-openai-api-key

# Hugging Face: optional, not used by default
HF_TOKEN=

# MySQL: defaults match docker-compose.yml
# Prisma CLI (migrations) uses DATABASE_URL; the app uses the split values.
DATABASE_URL=mysql://root:password@localhost:3306/my_ai_app
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=password
DATABASE_NAME=my_ai_app

# Express server port
PORT=3000
